{
  "name": "tangline",
  "version": "0.2.4",
  "private": true,
  "description": "A quiet macOS control console for mihomo",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "icon": "node scripts/build-icon.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "studio.tangline.app",
    "productName": "Tangline",
    "copyright": "Copyright © 2026 Tangline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/AppIcon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.7",
    "wait-on": "^8.0.2"
  }
}
